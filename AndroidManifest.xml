<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.adcover"
    android:versionCode="29"
    android:versionName="2.5.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />

    <!-- draw the cover over Prime Video -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- listen on 127.0.0.1 for show/hide commands from the watcher (via adb) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- low-RAM devices refuse notification listeners; DUMP (granted once over ADB with pm grant)
         lets DumpPoller read Prime's media session from the media_session service dump instead -->
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application android:label="Ad Cover" android:allowBackup="false">
        <service android:name=".CoverService" android:exported="true" android:foregroundServiceType="mediaProjection" />
        <!-- Android 8-10 only: invisible, fetches the screen-capture token for pause-ad checks -->
        <activity android:name=".CaptureActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- auto mode: read Prime Video's media session (needs notification access, granted once over ADB) -->
        <service android:name=".SessionListener" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- auto mode: one screenshot while paused, to spot pause-screen ads (Android 11+) -->
        <service android:name=".PauseAdService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/pause_ad_service" />
        </service>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
